<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CoralBridge</RootNamespace>
    <AssemblyName>CoralBridge.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0-preview.1.25080.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy native libraries to output -->
    <None Include="..\..\runtime\edgetpu_runtime\libedgetpu\direct\x64_windows\edgetpu.dll" CopyToOutputDirectory="PreserveNewest" Link="edgetpu.dll" />
    <None Include="..\..\runtime\tensorflowlite_c.dll" CopyToOutputDirectory="PreserveNewest" Link="tensorflowlite_c.dll" />
  </ItemGroup>
</Project>
